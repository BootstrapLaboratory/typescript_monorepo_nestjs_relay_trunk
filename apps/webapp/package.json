{
  "name": "webapp",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "start:dev": "npm run dev:relay & npm run dev",
    "deps:upgrade": "bash ../../scripts/upgrade-package-json-deps.sh --target webapp",
    "dev": "vite",
    "relay:compiler": "relay-compiler",
    "dev:relay": "npm run relay:compiler -- --watch",
    "relay": "npm run relay:compiler",
    "analyze": "npm run relay && tsc -b && vite build --mode analyze",
    "build": "npm run relay && tsc -b && vite build && npm run docs:compose",
    "build:dev": "npm run relay && tsc -b && vite build --mode development && npm run docs:compose",
    "docs:compose": "node scripts/copy-docs-build.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "storybook": "VITE_GRAPHQL_HTTP=/graphql VITE_GRAPHQL_WS=/graphql storybook dev -p 6006",
    "build-storybook": "VITE_GRAPHQL_HTTP=/graphql VITE_GRAPHQL_WS=/graphql storybook build"
  },
  "dependencies": {
    "@omgjs/labkit-auth-contract": "0.1.1",
    "@omgjs/labkit-runtime-config": "0.1.1",
    "@omgjs/labkit-webapp-auth": "0.1.1",
    "@omgjs/labkit-webapp-external-store": "0.1.1",
    "@omgjs/labkit-webapp-graphql-relay": "2.0.0",
    "@omgjs/labkit-webapp-realtime": "1.0.3",
    "@omgjs/labkit-webapp-ui": "0.1.1",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-router": "^1.169.2",
    "@vanilla-extract/css": "^1.20.1",
    "@vanilla-extract/recipes": "^0.5.7",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-relay": "^20.1.1",
    "relay-runtime": "^20.1.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@omgjs/labkit-webapp-build-config": "0.1.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@testing-library/dom": "^10.4.1",
    "@types/babel__core": "^7.20.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-relay": "^18.2.1",
    "@types/relay-runtime": "^20.1.1",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "api-contract": "workspace:*",
    "babel-plugin-relay": "^20.1.1",
    "docs-site": "workspace:*",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "graphql": "^16.14.0",
    "relay-compiler": "^20.1.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "^10.3.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.11"
  }
}
